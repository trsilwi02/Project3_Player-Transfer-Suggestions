# Database Connections (PostgreSQL 16 - Supabase / Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
REFRESH_TOKEN_PEPPER="your-secure-pepper-for-refresh-token-hashing"

# Application Settings
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Background Worker & Cron
CRON_SECRET="your-secure-cron-endpoint-secret"

# Push Notifications (best-effort)
FCM_SERVICE_ACCOUNT_JSON=""

# Supabase Server API (server-only for storage, client direct access disabled per D5/G5)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
