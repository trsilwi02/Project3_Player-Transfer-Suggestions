{
  "name": "football-transfer-system",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống thông tin hồ sơ cầu thủ, hợp đồng và hỗ trợ quyết định chuyển nhượng",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node --test tests/matching-engine-v2.integration.test.cjs",
    "test:vitest": "vitest run",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-demo.js",
    "generate:demo": "node scripts/generate-demo-data.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "typescript": "^5.4.5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "next": "16.4.6"
  }
}
