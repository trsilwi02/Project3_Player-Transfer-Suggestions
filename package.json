{
  "name": "football-transfer-system",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống thông tin hồ sơ cầu thủ, hợp đồng và hỗ trợ quyết định chuyển nhượng",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/db && npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/run-tests.js",
    "test:vitest": "vitest run",
    "db:check": "node scripts/db-check.js",
    "generate:demo": "node scripts/generate-demo-data.js"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
